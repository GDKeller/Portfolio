---
import Link from "./Link.astro";
import Nav from "./Nav.astro";
import SimpleModeToggle from "./SimpleModeToggle.astro";
import IconGitHub from "./icons/IconGitHub.svg";
import IconLinkedIn from "./icons/IconLinkedIn.svg";
import IconMenu from "./icons/IconMenu.svg";
import IconArrowDown from "./icons/IconArrowDown.svg";
import IconArrowUp from "./icons/IconArrowUp.svg";
import headshotDithered from "../images/headshots/grant-headshot-dithered.png";
import { RESUME_HREF, SOCIAL } from "../lib/site-links";
---

<div
  id="header__main"
  class="bg-background-dark sticky top-0 left-0 z-150 block w-full
    justify-between py-0 pr-0 pl-0 shadow-sm duration-100"
>
  <div
    class="border-box pattern-dots flex w-full items-stretch justify-between
      pl-px"
  >
    <div class="border-fainter box-border flex items-stretch gap-1 py-1 pl-0.5">
      <a
        id="home-link"
        href="#building"
        aria-label="Scroll to next section"
        data-state="at-hero"
        class="home-link text-emphasis focus-visible:bg-accent-hover
          focus-visible:text-background-dark bg-background-dark relative hidden
          h-8 w-8 shrink-0 overflow-hidden focus-visible:z-1 sm:block"
      >
        <IconArrowDown
          class="home-link__icon home-link__icon--down absolute inset-0 h-8 w-8"
        />
        <img
          src={headshotDithered.src}
          alt=""
          width="32"
          height="32"
          class="home-link__icon home-link__icon--face absolute inset-0"
        />
        <IconArrowUp
          class="home-link__icon home-link__icon--up absolute inset-0 h-8 w-8"
        />
      </a>
      <SimpleModeToggle />
      <Nav class="hidden sm:flex" />
    </div>
    <div
      class="relative w-full overflow-hidden"
      role="presentation"
      aria-hidden="true"
    >
      <div class="absolute top-1/2 -left-2 flex -translate-y-1/2">
        <p
          class="text-background-dark mr-4 font-mono text-7xl leading-none
            font-bold tracking-wide whitespace-nowrap opacity-20 select-none
            text-shadow-[0_0_0.01em_var(--color-faint),0_0_0.02em_var(--color-faint),0_0_0.04em_var(--color-faint)]"
        >
          STX \x02 0x47 0x4B
        </p>
      </div>
    </div>
    <div class="ml-auto flex gap-1 pl-px text-sm">
      <div class="hidden items-center gap-1 md:flex">
        <Link
          href={SOCIAL.github.url}
          target="_blank"
          variant="subtle"
          class="icon-link group hover:bg-accent-hover bg-background-dark
            focus-visible:bg-accent-hover hidden h-8 w-8 items-center
            justify-center p-2 focus-visible:z-1 md:flex"
        >
          <IconGitHub
            class="text-emphasis group-hover:text-background-dark
              group-focus-visible:text-background-dark h-8 w-10
              transition-colors duration-200"
          />
          <span class="sr-only">GitHub</span>
        </Link>
        <Link
          href={SOCIAL.linkedin.url}
          target="_blank"
          variant="subtle"
          class="icon-link group bg-background-dark hover:bg-accent-hover
            focus-visible:bg-accent-hover hidden h-8 w-8 items-center
            justify-center focus-visible:z-1 md:flex"
        >
          <IconLinkedIn
            class="text-emphasis group-hover:text-background-dark
              group-focus-visible:text-background-dark h-6 w-6 transition-colors
              duration-200"
          />
          <span class="sr-only">LinkedIn</span>
        </Link>
      </div>

      <div class="flex gap-0.5">
        <Link
          href={RESUME_HREF}
          target="_blank"
          variant="hoverAccent"
          class="bg-background-dark hover:bg-accent-hover
            hover:text-background-dark focus-visible:bg-accent-hover
            focus-visible:text-background-dark my-0.5 hidden items-center
            border-0 px-4 py-2 font-mono text-xs leading-none tracking-wide
            transition-colors duration-200 focus-visible:z-1 sm:flex"
        >
          <span>Resume</span>
        </Link>
        <button
          data-open-modal="hire_me_modal"
          aria-label="Contact"
          aria-expanded="false"
          aria-controls="hire_me_modal"
          class="text-background-dark bg-emphasis hover:bg-highlight
            focus-visible:bg-highlight relative my-0.5 hidden items-center px-6
            py-2 font-mono text-xs tracking-wide transition-colors duration-150
            hover:cursor-pointer focus-visible:z-1 sm:flex"
        >
          <span>Contact</span>
        </button>
        <button
          data-open-modal="mobile_menu"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile_menu"
          class="text-background-dark bg-emphasis hover:bg-highlight
            focus-visible:bg-highlight relative flex h-11 w-11 items-center
            justify-center transition-colors duration-150 hover:cursor-pointer
            focus-visible:z-1 sm:hidden"
        >
          <IconMenu class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #header__main :global(a:focus-visible),
  #header__main :global(button:focus-visible) {
    outline-offset: 0px;
  }

  .home-link :global(.home-link__icon) {
    display: none;
  }
  .home-link[data-state="at-hero"] :global(.home-link__icon--down) {
    display: block;
  }
  .home-link[data-state="past-hero"] :global(.home-link__icon--face) {
    display: block;
  }
  .home-link[data-state="past-hero"]:hover :global(.home-link__icon--face),
  .home-link[data-state="past-hero"]:focus-visible
    :global(.home-link__icon--face) {
    display: none;
  }
  .home-link[data-state="past-hero"]:hover :global(.home-link__icon--up),
  .home-link[data-state="past-hero"]:focus-visible
    :global(.home-link__icon--up) {
    display: block;
  }
</style>

<script>
  const homeLink = document.getElementById("home-link");
  const hero = document.getElementById("hero");

  if (homeLink && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          homeLink.dataset.state = "at-hero";
          homeLink.setAttribute("href", "#building");
          homeLink.setAttribute("aria-label", "Scroll to next section");
        } else {
          homeLink.dataset.state = "past-hero";
          homeLink.setAttribute("href", "#hero");
          homeLink.setAttribute("aria-label", "Back to top");
        }
      },
      { threshold: 0 },
    );
    observer.observe(hero);
  }
</script>
